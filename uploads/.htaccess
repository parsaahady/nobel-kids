# ═══════════════════════════════════════════════════════════════════════════
# Nobel Kids — /uploads/.htaccess
#
# THE MOST IMPORTANT SECURITY FILE IN THIS PROJECT.
# Everything here was uploaded through a form. Even though api/lib/storage.php
# validates content, re-encodes the filename and rejects polyglots, this file
# guarantees that NOTHING in this directory can ever execute as code.
# ═══════════════════════════════════════════════════════════════════════════

Options -Indexes -ExecCGI

# 1. Turn the PHP engine off completely for this directory tree.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2. Strip every handler that could run code (covers LiteSpeed / CGI / FPM,
#    which ignore php_flag). This is what actually stops PHP on most hosts.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pl .py .jsp .asp .htm .html .shtml .cgi .fcgi
RemoveType    .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pl .py .jsp .asp .cgi .fcgi
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .pl .py .cgi .fcgi .asp .jsp .sh

<IfModule mod_rewrite.c>
    RewriteEngine On
    # 3. Refuse to serve any script-ish filename at all, in any subfolder.
    RewriteRule \.(php|phtml|php[0-9]|phps|pl|py|jsp|asp|aspx|cgi|fcgi|sh|exe|htaccess)$ - [F,NC,L]
</IfModule>

# 4. Only allow real image extensions to be fetched. Anything else → 403.
<FilesMatch "(?i)\.(jpe?g|png|webp|gif|avif|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
<FilesMatch "(?i)^(?!.*\.(jpe?g|png|webp|gif|avif|svg)$).*$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # 5. Never let a browser sniff an upload into something executable, and
    #    neutralise SVG (which can contain scripts) with a strict CSP.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
