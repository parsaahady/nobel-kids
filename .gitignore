# ── Node / Next.js (build-time only; none of this ships to the host) ────────
node_modules
.next
out
dist
*.tsbuildinfo

# ── Build artefacts (regenerated by npm run build / npm run package) ────────
.static-data/
release/

# ── Secrets — NEVER commit ─────────────────────────────────────────────────
# config.php holds the database password, app.secret and any API keys.
config/config.php
.env
.env.*

# ── Runtime data ───────────────────────────────────────────────────────────
storage/logs/*
!storage/logs/.gitkeep
!storage/.htaccess
uploads/*
!uploads/.htaccess
*.log

# ── Local dev only ─────────────────────────────────────────────────────────
# Emulates .htaccess for `php -S`; never used in production.
.dev-router.php

# ── OS noise ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
